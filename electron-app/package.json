{
  "name": "tab5-game-controls",
  "version": "1.0.0",
  "description": "Tab5 Game Controls - Stream Deck style keyboard controller",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:bridge": "powershell -ExecutionPolicy Bypass -File ..\\\\simconnect-bridge\\\\scripts\\\\publish.ps1",
    "build": "npm run build:bridge && electron-builder",
    "build:win": "npm run build:bridge && electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "Tab5 User",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "fast-uri": "^3.1.1",
    "keysender": "2.4.0",
    "sharp": "0.34.5",
    "systeminformation": "^5.24.8",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.tab5.gamecontrols",
    "productName": "Tab5 Game Controls",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../simconnect-bridge/publish",
        "to": "bridge"
      }
    ],
    "asarUnpack": [
      "**/bridge/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
