+static inline bool sdio_pkt_len_reg_is_bus_fault(uint32_t reg_val)
+{
+	sdio_diag_last_pkt_len_raw = reg_val;
+	if (reg_val == UINT32_MAX) {
+		uint32_t count = ++sdio_diag_bus_faults;
+		ESP_LOGE(TAG, "PKT_LEN raw=0x%08"PRIx32
+				" (all 32 bits set): SDIO bus fault; consumed=%"PRIu32
+				" count=%"PRIu32,
+				reg_val, sdio_rx_byte_count, count);
+		return true;
+	}
+
+	/* Bits [19:0] are a modulo-2^20 cumulative byte counter. 0xFFFFF is
+	 * therefore legal. The old HomeTiles backport masked first and mistook
+	 * this value for a floating-bus read, then waited forever for a new edge. */
+	if ((reg_val & ESP_SLAVE_LEN_MASK) == ESP_SLAVE_LEN_MASK) {
+		uint32_t count = ++sdio_diag_legal_fffff_hits;
+		if (sdio_diag_should_log(count)) {
+			ESP_LOGE(TAG, "HomeTiles SDIO recovered legal PKT_LEN low20=0xFFFFF: "
+					"raw=0x%08"PRIx32" consumed=%"PRIu32" hit=%"PRIu32,
+					reg_val, sdio_rx_byte_count, count);
+		}
+	}
+	return false;
+}
