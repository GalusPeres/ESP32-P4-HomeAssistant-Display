+/* Public, lock-free field snapshot used only by HomeTiles diagnostics. */
+void hometiles_sdio_get_rx_diag(uint32_t *last_pkt_len_raw,
+		uint32_t *rx_byte_count, uint32_t *last_interrupts,
+		uint32_t *legal_fffff_hits, uint32_t *pending_drains,
+		uint32_t *alloc_retries, uint32_t *bus_faults)
+{
+	if (last_pkt_len_raw)
+		*last_pkt_len_raw = sdio_diag_last_pkt_len_raw;
+	if (rx_byte_count)
+		*rx_byte_count = sdio_rx_byte_count;
+	if (last_interrupts)
+		*last_interrupts = sdio_diag_last_interrupts;
+	if (legal_fffff_hits)
+		*legal_fffff_hits = sdio_diag_legal_fffff_hits;
+	if (pending_drains)
+		*pending_drains = sdio_diag_pending_drains;
+	if (alloc_retries)
+		*alloc_retries = sdio_diag_alloc_retries;
+	if (bus_faults)
+		*bus_faults = sdio_diag_bus_faults;
+}
