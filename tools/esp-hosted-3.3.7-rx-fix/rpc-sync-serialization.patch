+/*
+ * A FreeRTOS deinit may hard-delete the TX task at any instruction.  Detach
+ * every request-owned handle before invoking its free function so recovery
+ * cleanup can leak at worst, but can never free the same handle twice.
+ */
+static void release_tx_request_buffers(ctrl_cmd_t *request)
+{
+	void (*app_free_func)(void *) = NULL;
+	void *app_free_hdl = NULL;
+
+	if (!request)
+		return;
+
+	app_free_func = __atomic_load_n(&request->app_free_buff_func,
+			__ATOMIC_ACQUIRE);
+	app_free_hdl = __atomic_exchange_n(&request->app_free_buff_hdl, NULL,
+			__ATOMIC_ACQ_REL);
+	__atomic_store_n(&request->app_free_buff_func, NULL, __ATOMIC_RELEASE);
+	if (app_free_func && app_free_hdl)
+		app_free_func(app_free_hdl);
+
+	for (int i = 0; i < request->n_rpc_free_buff_hdls; i++) {
+		void *rpc_free_hdl = __atomic_exchange_n(
+				&request->rpc_free_buff_hdls[i], NULL, __ATOMIC_ACQ_REL);
+		if (rpc_free_hdl)
+			g_h.funcs->_h_free(rpc_free_hdl);
+	}
+	request->n_rpc_free_buff_hdls = 0;
+}
+
+static void cleanup_tx_request(ctrl_cmd_t *request)
+{
+	if (!request)
+		return;
+
+	release_tx_request_buffers(request);
+	HOSTED_FREE(request);
+}
+
+/* rpc_table_mutex must be held by the caller. */
+static int sync_request_is_active_locked(const ctrl_cmd_t *request)
+{
+	int exp_resp_msg_id = expected_response_id(request->msg_id);
+
+	for (int i = 0; i < MAX_SYNC_RPC_TRANSACTIONS; i++) {
+		if ((sync_rsp_table[i].uid == request->uid) &&
+				(sync_rsp_table[i].expected_msg_id == exp_resp_msg_id))
+			return 1;
+	}
+	return 0;
+}
+
+static int acquire_sync_transaction(void)
+{
+	uint64_t started_ms = g_h.funcs->_h_get_time_ms();
+	uint64_t waited_ms;
+	uint32_t blocked_uid = 0;
+	int blocked_req_id = 0;
+
+	if (g_h.funcs->_h_lock_mutex(rpc_table_mutex, HOSTED_BLOCK_MAX))
+		return FAILURE;
+	blocked_uid = active_sync_uid;
+	blocked_req_id = active_sync_req_id;
+	g_h.funcs->_h_unlock_mutex(rpc_table_mutex);
+
+	if (blocked_uid) {
+		ESP_LOGW(TAG, "RPC sync serialization wait: active uid %" PRIu32
+				" req [0x%x](%s)", blocked_uid, blocked_req_id,
+				rpc_id_name(blocked_req_id));
+	}
+
+	if (g_h.funcs->_h_lock_mutex(rpc_sync_mutex, HOSTED_BLOCK_MAX))
+		return FAILURE;
+
+	waited_ms = g_h.funcs->_h_get_time_ms() - started_ms;
+	if (blocked_uid || waited_ms >= 10) {
+		ESP_LOGW(TAG, "RPC sync serialization acquired after %" PRIu64
+				" ms (previous uid %" PRIu32 " req [0x%x])",
+				waited_ms, blocked_uid, blocked_req_id);
+	}
+
+	return SUCCESS;
+}
+
+static void release_sync_transaction(uint32_t request_uid)
+{
+	if (g_h.funcs->_h_lock_mutex(rpc_table_mutex, HOSTED_BLOCK_MAX) == SUCCESS) {
+		if (active_sync_uid == request_uid) {
+			active_sync_uid = 0;
+			active_sync_req_id = 0;
+		}
+		g_h.funcs->_h_unlock_mutex(rpc_table_mutex);
+	}
+	g_h.funcs->_h_unlock_mutex(rpc_sync_mutex);
+}
+
+/*
+ * Finish the TX side of an asynchronous request.  While tx_active is set,
+ * RX and the timeout callback may record an outcome but may not free app_req.
+ * This handoff makes exactly one path the owner of callback, timer and request.
+ */
+static int finish_async_tx(ctrl_cmd_t *app_req, bool tx_succeeded,
+		int failure_status)
+{
+	async_completion_t completion = { 0 };
+	ctrl_cmd_t *app_resp = NULL;
+	int result = ASYNC_TX_NOT_REGISTERED;
+
+	if (g_h.funcs->_h_lock_mutex(rpc_table_mutex, HOSTED_BLOCK_MAX))
+		return result;
+	for (int i = 0; i < MAX_ASYNC_RPC_TRANSACTIONS; i++) {
+		if (async_rsp_table[i].app_req != app_req)
+			continue;
+
+		if (tx_succeeded && !async_rsp_table[i].pending_response &&
+				!async_rsp_table[i].timeout_pending) {
+			async_rsp_table[i].tx_active = false;
+			result = ASYNC_TX_TABLE_OWNS;
+		} else {
+			detach_async_slot_locked(&async_rsp_table[i], &completion);
+			result = ASYNC_TX_COMPLETED;
+		}
+		break;
+	}
+	g_h.funcs->_h_unlock_mutex(rpc_table_mutex);
+
+	if (result != ASYNC_TX_COMPLETED)
+		return result;
+
+	if (completion.timer_hdl)
+		g_h.funcs->_h_timer_stop(completion.timer_hdl);
+
+	app_resp = completion.response;
+	if (!app_resp && !(completion.timed_out && completion.timeout_notified)) {
+		app_resp = g_h.funcs->_h_calloc(1, sizeof(ctrl_cmd_t));
+		if (app_resp) {
+			app_resp->msg_type = RPC_TYPE__Resp;
+			app_resp->msg_id = expected_response_id(app_req->msg_id);
+			app_resp->uid = app_req->uid;
+			app_resp->resp_event_status = completion.timed_out ?
+					RPC_ERR_REQUEST_TIMEOUT : failure_status;
+		}
+	}
+	if (completion.timed_out && !completion.timeout_notified) {
+		ESP_LOGW(TAG, "ASYNC Timeout uid %" PRIu32 " for req [0x%x](%s)",
+				app_req->uid, app_req->msg_id, rpc_id_name(app_req->msg_id));
+	}
+
+	HOSTED_FREE(completion.app_req);
+	if (completion.cb && app_resp)
+		completion.cb(app_resp);
+	return result;
+}
