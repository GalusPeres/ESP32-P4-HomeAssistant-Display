+/* rpc_table_mutex must be held by the caller. */
+static int uid_is_active_locked(uint32_t candidate)
+{
+	int i;
+
+	for (i = 0; i < MAX_SYNC_RPC_TRANSACTIONS; i++) {
+		if (sync_rsp_table[i].uid == candidate)
+			return 1;
+	}
+
+	for (i = 0; i < MAX_ASYNC_RPC_TRANSACTIONS; i++) {
+		if (async_rsp_table[i].uid == candidate)
+			return 1;
+	}
+
+	return 0;
+}
+
+/* rpc_table_mutex must be held by the caller. */
+static uint32_t allocate_uid_locked(void)
+{
+	/* At most the table population plus one candidates can be occupied. */
+	for (int i = 0; i <= MAX_SYNC_RPC_TRANSACTIONS + MAX_ASYNC_RPC_TRANSACTIONS; i++) {
+		uid++;
+		if (!uid)
+			uid++;
+		if (!uid_is_active_locked(uid))
+			return uid;
+	}
+
+	return 0;
+}
