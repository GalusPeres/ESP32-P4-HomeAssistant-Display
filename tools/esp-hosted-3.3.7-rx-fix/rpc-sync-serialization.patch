+
+/* rpc_table_mutex must be held by the caller. */
+static void clear_async_slot_locked(async_rsp_t *item)
+{
+	item->uid = 0;
+	item->expected_msg_id = 0;
+	item->cb = NULL;
+	item->timer_hdl = NULL;
+	item->app_req = NULL;
+	item->pending_response = NULL;
+	item->tx_active = false;
+	item->timeout_pending = false;
+	item->timeout_notified = false;
+}
+
+/* rpc_table_mutex must be held by the caller. */
+static void detach_async_slot_locked(async_rsp_t *item,
+		async_completion_t *completion)
+{
+	completion->cb = item->cb;
+	completion->timer_hdl = item->timer_hdl;
+	completion->app_req = item->app_req;
+	completion->response = item->pending_response;
+	completion->timed_out = item->timeout_pending;
+	completion->timeout_notified = item->timeout_notified;
+	clear_async_slot_locked(item);
+}
