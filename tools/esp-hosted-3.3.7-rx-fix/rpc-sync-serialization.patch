+static int expected_response_id(int request_id)
+{
+	if ((request_id <= RPC_ID__Req_Base) || (request_id >= RPC_ID__Req_Max))
+		return MSG_ID_OUT_OF_ORDER;
+
+	return request_id - RPC_ID__Req_Base + RPC_ID__Resp_Base;
+}
